# Конфигурация панели Eclipse Monitoring.
# Реальный .env создаётся установщиком (scripts/install.sh) и в git не попадает.
#
# ВАЖНО: AGENT_SECRET_ENCRYPTION_KEY менять нельзя после установки —
# им зашифрованы секреты уже подключённых агентов. Смена ключа = все агенты отваливаются.

# Публичный адрес панели, с https://
PANEL_PUBLIC_URL=https://panel.example.com

# Учётная запись администратора (создаётся при первом запуске)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Секреты — генерируются установщиком через openssl rand -hex 32
POSTGRES_PASSWORD=
JWT_SECRET=
AGENT_SECRET_ENCRYPTION_KEY=
